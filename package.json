{
  "name": "ignitoz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check --assist-enabled=false .",
    "lint": "biome lint .",
    "validate": "run-s check type-check",
    "test:unit": "vitest",
    "test:e2e": "playwright install && playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "pinia": "3.0.4",
    "vue": "3.5.32",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@playwright/test": "1.59.1",
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "28.0.1",
    "@types/node": "24.12.2",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "29.0.2",
    "npm-run-all2": "8.0.4",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vite-plugin-vue-devtools": "8.1.1",
    "vitest": "4.1.4",
    "vue-tsc": "3.2.6"
  },
  "engines": {
    "node": ">=24.18.0 <25.0.0"
  }
}
